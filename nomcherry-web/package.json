{
  "name": "nomcherry-web",
  "version": "1.1.0",
  "description": "Sistem Informasi Point of Sale, Inventori Multi-Cabang, dan Analitik NomCherry Café",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:demo": "node -e \"process.env.SEED_DEMO_DATA='true'; require('./src/server');\"",
    "dev": "node src/server.js",
    "bootstrap:admin": "node src/scripts/bootstrap-admin.js",
    "db:backup": "node src/scripts/db-backup.js backup",
    "db:rollback": "node src/scripts/db-backup.js rollback",
    "test": "node tests/test-nomcherry.js && node tests/audit-all-features.js && node tests/test-security.js && node tests/test-audit-remediation.js",
    "test:e2e": "node tests/e2e/e2e.test.js",
    "test:all": "npm test && npm run test:e2e"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "keywords": [
    "cafe",
    "pos",
    "kasir",
    "nomcherry",
    "rpl"
  ],
  "author": "Daffa Danendra Fairuzza & Team",
  "license": "ISC",
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "playwright-core": "^1.65.0"
  }
}
