# Salin ke .env dan isi nilai sebenarnya. Jangan pernah commit file .env.
PORT=3000
HOST=127.0.0.1
NODE_ENV=production
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter
NOMCHERRY_DB=./src/database/nomcherry.db
APP_TZ_OFFSET_MINUTES=420
LOG_REQUESTS=true

# Keamanan Bootstrap & Mode Demo:
# Biarkan SEED_DEMO_DATA=false di produksi agar akun demo bawaan tidak pernah dibuat otomatis.
SEED_DEMO_DATA=false

# Untuk database produksi baru yang masih kosong, isi kredensial admin awal di bawah ini
# ATAU jalankan: npm run bootstrap:admin
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator NomCherry
BOOTSTRAP_ADMIN_BRANCH=CBG001
